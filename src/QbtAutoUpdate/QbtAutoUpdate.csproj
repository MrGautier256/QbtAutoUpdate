<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: no console window flashes when the scheduled task starts the exe. -->
    <OutputType>WinExe</OutputType>
    <AssemblyName>QbtAutoUpdate</AssemblyName>
    <RootNamespace>QbtAutoUpdate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SatelliteResourceLanguages>en;fr</SatelliteResourceLanguages>
    <!-- Required by the [LibraryImport] source generator (P/Invoke without runtime marshalling). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Release artifacts: one self-contained file per architecture (dotnet publish -r win-x64).
       No IncludeNativeLibrariesForSelfExtract: the SYSTEM task must never load DLLs extracted to a
       writable temp folder (docs/DECISIONS.md D-29). -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\qbittorrent-5B7CC9A2.asc" LogicalName="QbtAutoUpdate.qbittorrent-5B7CC9A2.asc" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QbtAutoUpdate.Tests" />
  </ItemGroup>

</Project>
